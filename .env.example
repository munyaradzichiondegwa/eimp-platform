# ============================================================
# EBA EIMP - Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ---- Application ----
APP_NAME=EBA EIMP
NODE_ENV=development
API_PORT=3001
FRONTEND_PORT=3000
# Used to build links in verification/password-reset emails
ADMIN_PORTAL_URL=http://localhost:3000
CUSTOMER_PORTAL_URL=http://localhost:3002

# ---- Database (PostgreSQL) ----
POSTGRES_DB=eimp_db
POSTGRES_USER=eimp_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# ---- Cache & Queue (Redis) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ---- Authentication ----
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
NEXTAUTH_SECRET=CHANGE_THIS_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# ---- Encryption ----
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_ENCRYPTION_KEY

# ---- File Storage (AWS S3) ----
AWS_REGION=af-south-1
AWS_S3_BUCKET=eimp-documents-prod
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.cloudfront.net

# ---- Email (AWS SES) ----
SES_REGION=af-south-1
SES_FROM_EMAIL=noreply@ebamicroinsurance.co.zw
SES_FROM_NAME=EBA Micro Insurance
# Alternatively use SMTP:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=YOUR_SENDGRID_KEY

# ---- SMS Gateway ----
# Twilio (international fallback)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890
# Local: Econet Business SMS
ECONET_SMS_API_URL=https://api.econetbusiness.co.zw/sms/v1/send
ECONET_SMS_API_KEY=YOUR_ECONET_SMS_KEY
# Active provider: twilio | econet
SMS_PROVIDER=twilio

# ---- WhatsApp (Meta Cloud API via 360dialog) ----
WHATSAPP_API_URL=https://waba.360dialog.io/v1
WHATSAPP_API_KEY=YOUR_360DIALOG_KEY
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID

# ---- Mobile Money Integrations ----
# EcoCash Merchant API
ECOCASH_API_URL=https://api.ecocash.co.zw/merchant/v1
ECOCASH_MERCHANT_CODE=YOUR_ECOCASH_MERCHANT_CODE
ECOCASH_API_KEY=YOUR_ECOCASH_API_KEY
ECOCASH_API_SECRET=YOUR_ECOCASH_API_SECRET

# OneMoney (NetOne)
ONEMONEY_API_URL=https://api.netone.co.zw/onemoney/v1
ONEMONEY_API_KEY=YOUR_ONEMONEY_API_KEY
ONEMONEY_MERCHANT_NUMBER=YOUR_MERCHANT_NUMBER

# InnBucks
INNBUCKS_API_URL=https://api.innbucks.co.zw/v1
INNBUCKS_API_KEY=YOUR_INNBUCKS_API_KEY
INNBUCKS_MERCHANT_ID=YOUR_INNBUCKS_MERCHANT_ID

# ---- Banking Integration ----
# Standard Chartered Zimbabwe (example)
BANK_API_URL=https://api.standardchartered.co.zw/v1
BANK_API_KEY=YOUR_BANK_API_KEY
BANK_ACCOUNT_NUMBER=YOUR_BANK_ACCOUNT

# ---- Weather Data (ZIMMET / Alternative provider) ----
WEATHER_API_URL=https://api.openweathermap.org/data/3.0
WEATHER_API_KEY=YOUR_WEATHER_API_KEY

# ---- AI Features (Phase 2): Customer Support Chatbot ----
# Get an API key from https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
WEATHER_Zimbabwe_STATION_ID=ZW001

# ---- National ID Verification ----
# Zimbabwe Civil Registry API
CIVIL_REGISTRY_API_URL=https://api.civilregistry.gov.zw/v1
CIVIL_REGISTRY_API_KEY=YOUR_CIVIL_REGISTRY_KEY

# ---- Credit Bureau ----
TRANSUNION_API_URL=https://api.transunionzim.co.zw/v1
TRANSUNION_API_KEY=YOUR_TRANSUNION_KEY

# ---- Monitoring ----
SENTRY_DSN=YOUR_SENTRY_DSN
LOG_LEVEL=info

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME=EBA Micro Insurance
NEXT_PUBLIC_COMPANY_NAME=EBA Micro Insurance Company (Pvt) Ltd
